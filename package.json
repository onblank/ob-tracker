{
  "name": "ob-tracker",
  "version": "0.1.1",
  "private": true,
  "description": "OB-Tracker — offline open-source desktop time tracker by onBlank",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.4.1"
  },
  "scripts": {
    "dev": "pnpm --filter @obt/desktop dev",
    "build": "pnpm --filter @obt/desktop build",
    "package": "pnpm --filter @obt/desktop package",
    "package:win": "pnpm --filter @obt/desktop package:win",
    "package:mac": "pnpm --filter @obt/desktop package:mac",
    "package:linux": "pnpm --filter @obt/desktop package:linux",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "pnpm --filter @obt/desktop exec electron-builder install-app-deps"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
